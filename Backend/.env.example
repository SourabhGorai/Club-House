# Database Configuration
# Your local PostgreSQL credentials
DB_USER=your_postgres_username
DB_PASS=your_postgres_password

# JWT Secret Key
# IMPORTANT: Must be the same across all services
SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_secure

# Email Configuration (for user-service)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# ========================================
# INSTRUCTIONS:
# ========================================
# 1. Copy this file and rename it to .env
# 2. Replace all the placeholder values with your actual credentials
# 3. For MAIL_PASS, use Gmail App Password (not your regular password)
#    - Go to Google Account Settings > Security > 2-Step Verification > App Passwords
# 4. Keep the .env file secure and NEVER commit it to Git
